APP_NAME=Skillo
APP_VERSION=1.0.0
APP_DESCRIPTION=Offline-First AI Exam Platform
DEBUG=false

# Switch to postgresql://user:pass@host:port/dbname for production
DATABASE_URL=sqlite:///./skillo.db
DATABASE_ECHO=false

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Set to true when using HTTPS in production
COOKIE_SECURE=false

# SMTP — from_email defaults to SMTP_USER when not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true

# OAuth SSO (set these to enable Google/Apple sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Rate limit overrides (slowapi format: "[count]/[period]")
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_VERIFY_EMAIL=10/minute
RATE_LIMIT_RESEND_VERIFICATION=3/minute
RATE_LIMIT_UPDATE_PROFILE=10/minute
RATE_LIMIT_TOTP_VERIFY=10/minute
RATE_LIMIT_UPLOAD_PHOTO=5/minute
